@startuml

box "Application Service"
participant App as "Application"
end box

box "Submodel Repository Service"
  participant SMService as "Submodel Repository Interface"
  participant EventService as "Event Interface"
end box

box "Consuming Service"
  participant Client as "Client"
end box

activate App
App -> SMService : PatchSubmodelElementValueByPath(\nsubmodelId, "Measurements.temperature", 21.4)
activate SMService
App <-- SMService : SuccessNoContent
deactivate SMService
deactivate App

activate Client
Client -> EventService : GetAllEvents(submodelSemanticId, lastEventId)
activate EventService
Client <-- EventService : submodelelement.updated ("Measurements.temperature"),\nsubmodel.updated
deactivate EventService

Client -> Client : use the value of the Property\nfrom the event data

opt child elements of a modified SubmodelElementCollection needed
  Client -> SMService : GetSubmodelElementByPath(submodelId, idShortPath)
  activate SMService
  Client <-- SMService : SubmodelElement
  deactivate SMService
end

deactivate Client

@enduml
