<Interface Operation> ::= <Method Verb><Model Element Name>[<Modifier>]["By"<By-Qualifier>]["RecentChanges"|"Signed"]

<Method Verb> ::= "Get" | "GetAll" | "Query" |"Put" | "PutBulk" | "Post" | "PostAll" | "PostBulk"  | "Patch" | "CreateBulk" | "Delete" | "DeleteAll" | "DeleteBulk" | "Invoke" | "InvokeAsync" | "SearchAll" | "Generate"

<Model Element Name> ::= "AssetAdministrationShell"["Ids"|"s"] | "AssetAdministrationShellDescriptor"["Ids"|"s"] | "SubmodelReference"["s"] | "AssetInformation" | "AssetLinks" | "Submodel"["Ids"|"s"] | "SubmodelDescriptor"["Ids"|"s"] | "SubmodelElement"["s"] | "ConceptDescription"["Ids"|"s"] | "Operation" | "Thumbnail" | "File" | "Serialization" | "AASX" | "AASXPackage"["Ids"] | "SelfDescription" 

<Modifier> ::= "Value" | "Version" | "Sync" | "Async" | "AsyncStatus" | "AsyncResult"

<By-Qualifier> ::= "Id" | "SemanticId" | "Path" | "AssetId" | "AssetLink" | "IdShort" | "IsCaseOf" | "DataSpecificationReference" | "PackageId" | "IdAndDate"